/ A row's actions, for a table inside the password-reset controller. Fixed positioning lets
  the menu escape Tabulator's cells, which clip what overflows them.
- name = "#{user.forename} #{user.surname}"
.dropdown
  button.btn.btn-sm.btn-light.row-actions[type='button'
    aria-expanded='false'
    aria-label="Actions for #{name}"
    data-bs-toggle='dropdown'
    data-bs-popper-config={ strategy: 'fixed' }.to_json]
    i.fas.fa-ellipsis-vertical aria-hidden='true'
  ul.dropdown-menu.dropdown-menu-end
    li
      button.dropdown-item[type='button'
        data-action='password-reset#confirm'
        data-password-reset-url-param=user_password_reset_path(user)
        data-password-reset-name-param=name] Reset password
