/ Asks before a reset, then shows the new password; each row's actions menu fills it with
  the user it resets, through the password-reset controller around both. id must be unique
  on the page.
.modal.fade tabindex='-1' aria-labelledby="#{id}-title" data-password-reset-target='modal'
  .modal-dialog.modal-dialog-centered
    .modal-content
      .modal-header
        h2.modal-title.fs-5 id="#{id}-title" data-password-reset-target='title'
        button.btn-close type='button' data-bs-dismiss='modal' aria-label='Close'
      div data-password-reset-target='confirmStep'
        p.modal-body.text-danger.mb-0 role='alert' hidden=true data-password-reset-target='error'
        .modal-footer
          button.btn.btn-outline-secondary type='button' data-bs-dismiss='modal' Cancel
          button.btn.btn-danger type='button' data-action='password-reset#reset' Reset password
      div hidden=true data-password-reset-target='resultStep'
        p.modal-body.fs-3.font-monospace.mb-0 data-password-reset-target='password'
        .modal-footer
          button.btn.btn-outline-secondary[type='button'
            data-password-reset-target='copyButton'
            data-action='password-reset#copy'] Copy
          button.btn.btn-primary type='button' data-bs-dismiss='modal' Done
