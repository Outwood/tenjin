- content_for :title
  title = "Questions - #{@topic.name}"
.container
  = render('questions/breadcrumbs', topic: @topic)
  .d-flex.flex-wrap.align-items-center.justify-content-between.gap-2.mb-3
    h1.topic-name.mb-0 = @topic.name
    .d-flex.flex-wrap.gap-2
      = link_to 'Add Question', new_topic_question_path(@topic), class: 'btn btn-primary'
      = link_to 'Download Questions (JSON)', topic_questions_path(@topic, format: :json), class: 'btn btn-outline-secondary'
      = link_to 'Import Questions', new_topic_import_path(@topic), class: 'btn btn-outline-secondary'
  - unless @topic.active?
    / Mirrors the active filters in QuizzesController, Quiz::CreateQuiz, Challenge, LessonsController and QuestionsController
    p.alert.alert-secondary#inactive-topic
      | This topic is inactive: it isn't offered for quizzes, challenges or new lessons, and the Questions page
        doesn't list it. Teachers can still set homework on it.
  / One form, because Turbo cancels a submission still in flight when another starts on the page;
    the newer write then carries both fields, and its reply settles the status and heading
  = form_with url: topic_path(@topic),
    method: :patch,
    class: 'mb-4',
    data: { turbo: true, controller: 'auto-submit', action: 'turbo:submit-end->auto-submit#settle' } do
    .row.mb-3
      = label_tag 'topic_name', 'Name', class: 'col-sm-3 col-form-label'
      .col-sm-9
        = text_field_tag 'topic[name]',
          @topic.name,
          class: 'form-control',
          data: { action: 'change->auto-submit#submit' }
    .row
      - if @lessons.empty?
        .col-sm-3.col-form-label Default lesson
        .col-sm-9
          p.form-control-plaintext.mb-0#no-lessons
            | This topic has no lessons yet.
            / New lessons go only in active topics
            - if @topic.active? && policy(Lesson.new(topic: @topic)).new?
              =< link_to 'Add a lesson', new_subject_lesson_path(@topic.subject, topic_id: @topic.id),
                class: 'btn btn-sm btn-outline-secondary ms-2'
          .form-text role='status' data-auto-submit-target='status'
      - else
        = label_tag 'topic_default_lesson_id', 'Default lesson', class: 'col-sm-3 col-form-label'
        .col-sm-9
          = select_tag 'topic[default_lesson_id]',
            options_from_collection_for_select(@lessons, :id, :title, selected: @topic.default_lesson_id),
            include_blank: 'No default lesson',
            class: 'form-select',
            data: { action: 'change->auto-submit#submit' }
          .form-text role='status' data-auto-submit-target='status'
  = render 'questions/question_table'
  section.mt-5.mb-5 aria-labelledby='danger-zone-heading'
    h2#danger-zone-heading Danger Zone
    p
      | Deleting this topic also deletes its questions, lessons, quizzes and challenges,
        any homework set on it, and students' scores for it.
    = button_to 'Delete Topic',
      topic_path(@topic),
      method: :delete,
      class: 'btn btn-danger',
      form: { data: { turbo: true, turbo_confirm: "Delete #{@topic.name} and everything in it? This cannot be undone." } }
