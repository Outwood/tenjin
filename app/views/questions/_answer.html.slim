/ An answer marked for deletion stays in the form, hidden, so the next save deletes it
tr hidden=f.object.marked_for_destruction?
  td
    - if f.object.marked_for_destruction?
      = f.hidden_field(:_destroy)
    = f.text_field(:text, id: "answer-text-#{f.index}",
                    placeholder: "Click here to add answer",
                    class: 'form-control text-answer',
                    readonly: (@question.boolean? ? true : false))
  - unless @question.short_answer? || @question.question_type.nil?
    td
      - if @question.boolean?
        = radio_button_tag('question[correct_answer]', f.object.text, f.object.text == chosen_boolean_label(@question),
            id: "answer-check-#{f.index}",
            class: 'form-check-input')
      - else
        = f.check_box(:correct,
            onchange: "this.setAttribute('data-params', '#{f.object_name}[correct]=' + this.checked*this.checked)",
            id: "answer-check-#{f.index}",
            class: 'form-check-input')
  - unless @question.boolean?
    td
      - if f.object.persisted?
        = link_to 'Remove', '#',
          class: 'btn btn-danger',
          data: { object_name: f.object_name, action: 'click->nested-fields#removeRecord' }
      - else
        = link_to 'Remove', '#', class: 'btn btn-danger', data: { action: 'click->nested-fields#removeRow' }
