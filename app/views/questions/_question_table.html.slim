/ The Question column takes the spare width; on a narrow screen the numbers fold under each row.
/ The search box reads question and lesson text, not the statistics beside them.
- number = { sorter: 'number', hozAlign: 'right', headerHozAlign: 'right' }
- table_options = { paginationSize: 50,
    placeholder: 'No questions have been found',
    searchFields: %w[question lesson],
    responsiveLayout: 'collapse',
    columns: [{ title: '#', field: 'number', width: 72, responsive: 3, **number },
      { title: 'Question', field: 'question', minWidth: 240, widthGrow: 4, cssClass: 'text-wrap' },
      { title: 'Times asked', field: 'times_asked', minWidth: 160, responsive: 2, **number },
      { title: 'Flags', field: 'flags', minWidth: 90, responsive: 1, **number },
      { title: 'Percent correct', field: 'percent_correct', minWidth: 170, responsive: 2, **number, sorter: 'percent' }] }
ruby:
  questions = @questions.order(:created_at).to_a
  # Shown only when a listed question has a lesson, since otherwise every cell is a dash
  lesson_column = questions.any?(&:lesson_id)
- if lesson_column
  - table_options[:columns] << { title: 'Lesson', field: 'lesson', minWidth: 160, widthGrow: 2, cssClass: 'text-wrap', responsive: 3 }
.question-table data-controller='datatable' data-datatable-options-value=table_options.to_json
  = render 'shared/table_search', label: 'Search questions'
  table.table#questionTable data-datatable-target='table'
    thead
      tr
        / Each heading must match its column's title above, which Tabulator pairs it by
        th #
        th Question
        th Times asked
        th Flags
        th Percent correct
        - if lesson_column
          th Lesson
    tbody
      - questions.each_with_index do |q, index|
        tr id="question-#{q.id}"
          td = index + 1
          td.question-text = link_to q.question_text.blank? ? 'Click here to edit' : q.question_text, edit_question_path(q)
          td.amount = times_asked(q)
          td.flags = q.flagged_questions.size
          td.correct = percentage_correct(q)
          - if lesson_column
            td.lesson = q.lesson ? link_to(q.lesson.title, lesson_questions_path(q.lesson)) : '-'
