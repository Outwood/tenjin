= form_with model: @question, url: question_form_url(@question), id: 'questionForm', local: true,
  data: { controller: 'nested-fields reload-form' } do |f|
  - if @question.errors.any?
    .alert.alert-danger.my-2 role='alert'
      p.fw-bold.mb-1 Fix these before saving the question:
      ul.mb-0
        - question_error_messages(@question).each do |message|
          li = message
  .row.my-2
    .col-sm-3
      = f.label(:question_type, 'Question Type', class: 'col-form-label')
    .col-sm-9
      = f.select( :question_type,
        options_for_select(Question.question_types.to_a.map { |k| [k[0].humanize, k[0]] }, selected: @question.question_type ),
        {},
        class: 'form-select',
        data: { action: 'change->reload-form#reload' } )
  .my-2
    = f.label(:question_text, 'Question', id: 'question-text-label', class: 'form-label')
    = f.rich_text_area(:question_text, aria: { labelledby: 'question-text-label' })
  .row.my-2
    .col-sm-3
      = f.label(:lesson_id, 'Lesson', class: 'col-form-label')
    .col-sm-9
      = f.select( :lesson_id,
          options_from_collection_for_select(@question.topic.lessons, :id, :title, selected: @question.lesson_id),
          { include_blank: 'Select Lesson' },
          class: 'form-select')
  - if @question.persisted?
    .row.my-2
      .col-sm-3
        = f.label(:topic_id, 'Topic', class: 'col-form-label')
      .col-sm-9
        = f.select( :topic_id,
            options_from_collection_for_select( @question.topic.subject.topics.order(:name),
              :id, :name, selected: @question.topic_id),
            {},
            class: 'form-select',
            data: { action: 'change->reload-form#reload' })
  table.table#table-answers
    thead
      tr
        th#answer-text-header Answer Text
        - if marks_correct_answers?(@question)
          th#answer-correct-header Correct?
        - unless @question.boolean?
          th
            span.visually-hidden Actions
    tbody.fields data-nested-fields-target='fields'
      = f.fields_for :answers do |a|
        = render 'questions/answer', f: a
  - unless @question.boolean?
    .row.my-2
      .col
        = add_row_button('Add Answer', f, :answers, partial: 'questions/answer', class: 'btn btn-primary w-100')
  .row.my-2
    .col
      = f.submit("Save Question", class: 'btn w-100 btn-success')
