h2.admin-section-heading = role.humanize.pluralize
.table-responsive
  table.table id="#{role}-table"
    thead
      tr
        th Name
        th Username
        - if role == 'school_admin'
          th School
        - else
          th Subject
        th Remove
    tbody
      - role_collection.each do |r|
        tr
          td
            => r.forename
            = r.surname
          td = r.username
          - if role == 'school_admin'
            td = r.school.name
          - else
            td = select_tag 'user[subject]',
                options_from_collection_for_select(Subject.authored_by(r, role), :id, :name),
                id: "subject-select-#{role}-#{r.id}",
                aria: {label: "Subject for #{r.forename} #{r.surname}"},
                class: 'form-select form-select-sm',
                form: "form-#{role}-#{r.id}"
          td = button_to 'Remove',
            remove_role_system_user_path(id: r.id),
            class: 'btn btn-sm btn-outline-danger',
            method: :delete,
            params: {user: { role: role} },
            form: { id: "form-#{role}-#{r.id}", data: { turbo: true } }
