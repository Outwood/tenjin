- content_for :title
  title = "Questions - #{@lesson.title}"
/ A lesson's questions share its topic, so one check covers adding and editing them all
- author = policy(Question.new(topic: @lesson.topic)).create?
.container
  = render "lessons/breadcrumbs", subject: @lesson.subject, topic: @lesson.topic, current: @lesson.title
  .d-flex.flex-wrap.align-items-center.justify-content-between.gap-2.mb-3
    h1.mb-0 = "Questions for #{@lesson.title}"
    - if author
      = link_to "Add Question", new_topic_question_path(@lesson.topic, question: { lesson_id: @lesson.id }),
        class: "btn btn-primary"

  - if @questions.blank?
    p.text-body-secondary#no-questions This lesson has no questions yet.
  - else
    ol.list-unstyled.d-grid.gap-3.mb-5#lesson-questions
      - @questions.each.with_index(1) do |q, number|
        li.card id=dom_id(q)
          .card-body
            .d-flex.flex-wrap.align-items-center.gap-2.mb-2
              h2.h5.mb-0 = "Question #{number}"
              span.badge.rounded-pill.text-bg-light.border.question-type = question_type_label(q)
              - if author
                = link_to "Edit", edit_question_path(q), class: "btn btn-sm btn-outline-primary ms-auto",
                  aria: { label: "Edit question #{number}" }
            / Rich text renders its own block element, so it cannot sit in a paragraph
            .question-text.mb-3
              - if q.question_text.blank?
                p.fst-italic.text-body-secondary.mb-0 = "(no question text)"
              - else
                == q.question_text
            / Every answer to a short-answer question is accepted, so none is singled out
            p.small.text-body-secondary.mb-1 = q.short_answer? ? 'Accepted answers' : 'Answers'
            ul.list-unstyled.mb-0.answers
              - listed_answers(q).each do |a|
                li.answer.py-1 id=dom_id(a)
                  => a.text
                  - if a.correct? && !q.short_answer?
                    span.badge.text-bg-success.ms-1 Correct
