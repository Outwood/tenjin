- topic_locked = @lesson.topic_locked?
/ A refused move's error already says what the hint would
- topic_hint = topic_locked && @lesson.errors[:topic].none?
= simple_form_for @lesson, wrapper: :horizontal_form, wrapper_mappings: { select: :horizontal_select } do |f|
  = f.input :title
  / simple_form renders hints without linking them to their input
  = f.input :video_link, as: :url,
    hint: 'A YouTube or Vimeo link. Leave blank for a lesson without a video.',
    hint_html: { id: 'lesson_video_link_hint' },
    input_html: { aria: { describedby: 'lesson_video_link_hint' } }
  = f.association :topic, collection: @topics, include_blank: false,
    label_method: ->(topic) { topic.active? ? topic.name : "#{topic.name} (inactive)" },
    disabled: topic_locked,
    hint: ("The topic can't change while the lesson has questions." if topic_hint),
    hint_html: { id: 'lesson_topic_hint' },
    input_html: { aria: { describedby: ('lesson_topic_hint' if topic_hint) } }
  .d-flex.flex-wrap.gap-2.mt-4
    = f.button :submit, 'Save Lesson', class: 'btn-primary'
    = link_to 'Cancel', cancel_path, class: 'btn btn-outline-secondary'
