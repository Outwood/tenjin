- content_for :title
  title = "Homework - #{@homework.title} - #{@homework.classroom.name}"
.container
  nav.mt-3.breadcrumb-chevron aria-label='Breadcrumb'
    ol.breadcrumb.mb-1
      li.breadcrumb-item = link_to 'My Classes', dashboard_path
      li.breadcrumb-item = link_to @homework.classroom.name, @homework.classroom
      li.breadcrumb-item.active aria-current='page' = @homework.title
  .mb-4
    h1 = @homework.title
    dl.row.mb-0#homework-details
      dt.col-sm-3 Topic
      dd.col-sm-9 = @homework.topic.name
      dt.col-sm-3 Lesson
      dd.col-sm-9 = @homework.lesson&.title || 'Whole topic'
      dt.col-sm-3 Pass mark
      dd.col-sm-9 = "#{number_to_percentage(@homework.required, precision: 0)} in one quiz"
      dt.col-sm-3 Due
      dd.col-sm-9 = homework_due_time(@homework)
      dt.col-sm-3 Completion
      dd.col-sm-9#homework-completion = report_progress(@homework_counts)
  section.mb-5#pupils aria-labelledby='pupils-heading'
    h2.mb-3#pupils-heading Pupils
    / Names stay put on a narrow screen and the rest fold under each row, still copying and downloading
    - export = { clipboard: true, download: true }
    - pupils_table_options = { pagination: false,
        placeholder: 'No pupils are enrolled in this class.',
        searchFields: %w[first_name last_name],
        responsiveLayout: 'collapse',
        columns: [{ title: 'First name', field: 'first_name', minWidth: 120, responsive: 0 },
          { title: 'Last name', field: 'last_name', minWidth: 120, responsive: 0 },
          { title: 'Status', field: 'status', minWidth: 140, responsive: 1, **export },
          { title: 'Best score', field: 'best_score', minWidth: 120, sorter: 'percent',
            hozAlign: 'right', headerHozAlign: 'right', responsive: 2, **export }] }.to_json
    div[data-controller='datatable'
      data-datatable-options-value=pupils_table_options
      data-datatable-filename-value=csv_filename("#{@homework.classroom.name} #{@homework.title} pupils")]
      .d-flex.flex-wrap.gap-2
        .flex-grow-1 = render 'shared/table_search', label: 'Search pupils'
        .d-flex.gap-2.mb-2
          button.btn.btn-outline-secondary type='button' data-action='click->datatable#copy' Copy
          button.btn.btn-outline-secondary type='button' data-action='click->datatable#downloadCsv' CSV
      / Each heading must match its column's title above, which Tabulator pairs it by
      table.table#pupils-table data-datatable-target='table'
        thead
          tr
            th First name
            th Last name
            th Status
            th Best score
        tbody
          - @pupils.each do |pupil|
            - progress = @progress[pupil.id]
            tr.student-row data-user=pupil.id
              / Visible as the first name, which its column heads; spoken as the full name
              td = link_to pupil.forename, user_path(pupil), aria: { label: "#{pupil.forename} #{pupil.surname}" }
              td = pupil.surname
              td = homework_status(@homework, progress)
              td = number_to_percentage(progress.progress, precision: 0) if progress
  section.mb-5 aria-labelledby='danger-zone-heading'
    h2#danger-zone-heading Danger Zone
    = button_to 'Delete Homework', homework_path(@homework),
      method: :delete,
      class: 'btn btn-danger',
      form: { data: { turbo: true, turbo_confirm: "Delete this homework? Every pupil's progress on it will be lost." } }
