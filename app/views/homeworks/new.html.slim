- content_for :title
  title = "Set Homework - #{@classroom.name}"
.container data-controller='homework' data-homework-lessons-value=@lessons.to_json(only: %i[id topic_id title])
  nav.mt-3.breadcrumb-chevron aria-label='Breadcrumb'
    ol.breadcrumb.mb-1
      li.breadcrumb-item = link_to 'My Classes', dashboard_path
      li.breadcrumb-item = link_to @classroom.name, @classroom
      li.breadcrumb-item.active aria-current='page' Set homework
  h1.mb-3 Set homework
  = simple_form_for [@classroom, @homework], wrapper: :horizontal_form, wrapper_mappings: { select: :horizontal_select } do |f|
    / simple_form renders an error without linking it to its field
    - error_id = ->(attribute) { "homework_#{attribute}_error" if @homework.errors[attribute].any? }
    = f.input :due_date, as: :string, label: 'Due date',
      full_error_html: { id: 'homework_due_date_error' },
      input_html: { aria: { describedby: error_id[:due_date] }, data: { controller: 'datepicker' } }
    = f.input :required, label: 'Required %', collection: (0..100).step(10),
      full_error_html: { id: 'homework_required_error' },
      input_html: { aria: { describedby: error_id[:required] } }
    / The belongs_to check carries a condition, so simple_form would read the topic as optional
    = f.association :topic, collection: @classroom.subject.topics.order(:name),
      required: true,
      full_error_html: { id: 'homework_topic_error' },
      input_html: { aria: { describedby: error_id[:topic] }, data: { action: 'change->homework#loadLessons' } }
    / A re-rendered form already has a topic, and no change event will fill its lessons
    - topic_lessons = @lessons.select { |lesson| lesson.topic_id == @homework.topic_id }
    = f.input :lesson_id, as: :select, collection: topic_lessons, label_method: :title, label: 'Lesson (Optional)',
      hint: "Only lessons with at least #{Quiz::QUESTION_COUNT} questions can be set.",
      hint_html: { id: 'homework_lesson_id_hint' },
      input_html: { disabled: topic_lessons.empty?, aria: { describedby: 'homework_lesson_id_hint' },
        data: { homework_target: 'lessonSelect' } }
    .d-flex.flex-wrap.gap-2.mt-4
      = f.button :submit, 'Set Homework', class: 'btn-primary'
      = link_to 'Cancel', @classroom, class: 'btn btn-outline-secondary'
