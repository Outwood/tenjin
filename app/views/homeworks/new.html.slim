- content_for :title
  title New Homework
section.page-section.text-center.pt-2#set_homework
  .container data-controller='homework' data-homework-lessons-value=@lessons.to_json
    h1.page-section-header.text-uppercase Set Homework
    p.lead = @classroom.name
    ==render_small_separator
    = simple_form_for [@classroom, @homework] do |f|
      = f.input :due_date, as: :citext, label: 'Due date',
        input_html: { class: 'datepicker col-sm-9 form-control', data: { controller: 'datepicker' } },
        label_html: { class: 'col-sm-3 col-form-label' },
        wrapper_html: { class: 'row mb-3' }
      = f.input :required, label: 'Required %', collection: (0..100).step(10),
        input_html: { class: 'col-sm-9 form-control' },
        label_html: { class: 'col-sm-3 col-form-label' },
        wrapper_html: { class: 'row mb-3' }
      = f.association :topic, collection: @classroom.subject.topics.order(:name),
        input_html: { class:'col-sm-9 form-control', data: { action:'change->homework#loadLessons' } },
        label_html: { class: 'col-sm-3 col-form-label' },
        wrapper_html: { class: 'row mb-3' }
      / A re-rendered form already has a topic, and no change event will fill its lessons
      - topic_lessons = @lessons.select { |lesson| lesson.topic_id == @homework.topic_id }
      = f.input :lesson_id,
        as: :select,
        collection: topic_lessons,
        label_method: :title,
        label: 'Lesson (Optional)',
        input_html: { class:'col-sm-9 form-control', disabled: topic_lessons.empty?, data: { 'homework-target':'lessonSelect' } },
        label_html: {class: 'col-sm-3 col-form-label'},
        wrapper_html: {class: 'row mb-3'}
      = f.submit "Set Homework", class: 'btn btn-primary'
