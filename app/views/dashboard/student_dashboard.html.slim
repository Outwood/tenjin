- content_for :title
  title Dashboard
h1.visually-hidden Dashboard
section.page-section.text-center#newQuiz
  .container#startAQuizContainer
    h2.page-section-header.text-uppercase Start a Quiz
    p.lead Select a subject below
    ==render_small_separator(dashboard_style)
    .carousel.slide.col-md-8.col-lg-5.mx-auto#subjectCarousel data-bs-interval="false"
      ol.carousel-indicators
        - @subjects.each_with_index do |s, i|
          li data-bs-target="#subjectCarousel" data-bs-slide-to=i class=('active' if i.zero?)
      .carousel-inner
        - @subjects.each_with_index do |s, i|
            .carousel-item class=('active' if i.zero?)
              a href=new_subject_quiz_path(s)
                = image_pack_tag(subject_image(s), class: 'w-100 subject-carousel-item-image', alt: s.name)
                .carousel-caption
                  h3.text-uppercase = s.name
      a.carousel-control-prev href="#subjectCarousel" role="button" data-bs-slide="prev"
        span.carousel-control-prev-icon aria-hidden="true"
        span.visually-hidden Previous
      a.carousel-control-next href="#subjectCarousel" role="button" data-bs-slide="next"
        span.carousel-control-next-icon aria-hidden="true"
        span.visually-hidden Next
= render('shared/homework')
section#challenges.page-section.text-center
  .container
    h2.page-section-header.text-uppercase Challenges
    ==render_small_separator(dashboard_style)
    .row.justify-content-center
      .col-lg-10.col.mx-auto.table-responsive
        table.table.table-hover#challenge-table
          thead
            tr
              th Challenge
              th Progress
              th.d-none.d-sm-table-cell Points
              th Expires in
          tbody
            - @challenges.each do |c|
                - topic_value = c.daily? ? 'Lucky Dip' : c.topic.id.to_s
                tr.challenge-row(data-challenge=c.id data-topic=topic_value data-subject=c.topic.subject_id
                  data-controller='quiz-starter'
                  data-quiz-starter-url-value=subject_quizzes_path(c.topic.subject_id)
                  data-quiz-starter-topic-value=topic_value
                  data-action='click->quiz-starter#start')
                  td.text-start = c.stringify
                  td = challenge_progress_display(c, @challenge_progresses)
                  td.d-none.d-sm-table-cell
                    = c.points
                    i.fas.fa-star.text-warning aria-hidden="true"
                  td = challenge_time_left(c)
- if current_user.oauth_email.blank?
  input#oAuthEmail type='hidden'
