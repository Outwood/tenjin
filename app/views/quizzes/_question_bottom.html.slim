.container.py-2
  .row
    .col
      - if @quiz.lesson.blank?
        p#quiz-name = @question.topic.name
      - else
        p#quiz-name = @question.lesson.title
    .col
      p.text-end
        = link_to flag_icon,
          question_flag_path(@question),
          class: 'btn',
          id: 'unfairFlag',
          'aria-label': 'Flag this question as unfair',
          data: { controller: 'unfair-flag', action: 'click->unfair-flag#flag' }

- unless @quiz.counts_for_leaderboard
  .row.col-lg-8.mx-auto.alert.alert-warning
    | This quiz is currently not counting towards your leaderboard points.
      The first attempt at a lesson homework will count, or the first four quizzes for a particular topic.

#feedbackModal.modal.fade
  .modal-dialog role="document"
    .modal-content
      .modal-body
        p#feedback You have flagged this question as unfair.  Thanks for your feedback!
      .modal-footer
        button.btn.btn-secondary type="button" data-bs-dismiss="modal"
          | Close
