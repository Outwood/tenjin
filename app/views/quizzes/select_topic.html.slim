section.page-section.text-center#newQuiz
  .container
    h1.page-section-header.text-uppercase Select Topic
    p.lead = @subject.name
    ==render_small_separator(dashboard_style)

    = simple_form_for(Quiz.new, url: subject_quizzes_path(@subject)) do |f|
        = f.input :topic_id, label: 'Pick a topic:',as: :select, collection: @topics, include_blank: false
        = f.button :submit, class: 'btn btn-dark'
