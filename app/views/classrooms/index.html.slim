- content_for :title
  title Classrooms
.container
  section.page-section.text-center.pt-2#classrooms(data-controller='sync-notice'
    data-sync-notice-needed-label-value=ClassroomsHelper::SYNC_NEEDED_NOTICE
    data-action='turbo:submit-end->sync-notice#settle')
    p
      span#syncStatus data-sync-notice-target='status' = sync_notice(@school)
      / Public-site links share the body colour, so the underline is what marks this as one
      =< link_to 'School overview', school_path(@school), class: 'text-decoration-underline'
    h1.page-section-header.text-uppercase Classrooms
    ==render_small_separator
    - datatable_options = { paginationSize: 25, placeholder: 'No classrooms have been found' }.to_json
    .row.justify-content-center
      .col.mx-auto data-controller='datatable' data-datatable-options-value=datatable_options
        = render 'shared/table_search'
        table.table.table-hover#classroom-table data-datatable-target='table'
          thead
            tr
              th Name
              th.d-none.d-lg-table-cell Number Students
              th Subject
          tbody
            - @classrooms.each do |c|
              tr
                td = c.name
                td.d-none.d-lg-table-cell = c.enrollments.size
                td
                  = form_with url: classroom_path(c.id),
                    method: :patch,
                    data: { turbo: true, controller: 'auto-submit', action: 'turbo:submit-end->auto-submit#settle' } do
                    = select_tag :subject,
                      options_from_collection_for_select(@subjects, :id, :name, c.subject_id),
                      include_blank: '',
                      id: ('classroom-' + c.id.to_s),
                      class: 'form-select',
                      data: { action: 'change->auto-submit#submit sync-notice#notify' }
