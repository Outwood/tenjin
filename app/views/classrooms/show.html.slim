- content_for :title
  title = "Classroom - #{@classroom.name}"
.container
  / The dashboard lists a teacher's own classes and the school's others, so it is the way back from either
  nav.mt-3.breadcrumb-chevron aria-label='Breadcrumb'
    ol.breadcrumb.mb-1
      li.breadcrumb-item = link_to 'My Classes', dashboard_path
      li.breadcrumb-item.active aria-current='page' = @classroom.name
  .mb-4
    h1.mb-0 = @classroom.name
    - if @classroom.subject
      p.lead.mb-0#classroom-subject = @classroom.subject.name
  section.mb-5#homework aria-labelledby='homework-heading'
    .d-flex.flex-wrap.align-items-center.justify-content-between.gap-2.mb-3
      h2.mb-0#homework-heading Homework
      = link_to 'Set Homework', new_classroom_homework_path(@classroom), class: 'btn btn-primary'
    / Topic takes the spare width; on a narrow screen the other columns fold under each row
    - homework_table_options = { placeholder: 'No homework set yet',
        initialSort: [{ column: 'due', dir: 'desc' }],
        responsiveLayout: 'collapse',
        columns: [{ title: 'Topic', field: 'topic', minWidth: 160, widthGrow: 2, cssClass: 'text-wrap', responsive: 0 },
          { title: 'Lesson', field: 'lesson', minWidth: 160, widthGrow: 2, cssClass: 'text-wrap', responsive: 3 },
          { title: 'Completion', field: 'completion', minWidth: 150, sorter: 'percent', responsive: 2 },
          { title: 'Due', field: 'due', minWidth: 150, sorter: 'timeDatetime', responsive: 1 }] }.to_json
    div data-controller='datatable' data-datatable-options-value=homework_table_options
      table.table.table-hover#homework-table data-datatable-target='table'
        / Each heading must match its column's title above, which Tabulator pairs it by
        thead
          tr
            th Topic
            th Lesson
            th Completion
            th Due
        tbody
          - @homeworks.each do |h|
            tr.homework-data data-id=h.id
              td = link_to h.topic.name, homework_path(h)
              td = h.lesson&.title || 'Whole topic'
              td = report_progress(h)
              td = homework_due_time(h)
  section.mb-5#students aria-labelledby='students-heading'
    h2.mb-3#students-heading Pupils
    / Names stay put on a narrow screen and the rest fold under each row. Folded columns
      still copy and download, so an export has the same columns at any width. The homework
      strip and the actions menu export nothing: the strip's text is its hidden labels run together.
    - export = { clipboard: true, download: true }
    - students_table_options = { pagination: false,
        placeholder: 'No pupils are enrolled in this class.',
        searchFields: %w[first_name last_name username],
        responsiveLayout: 'collapse',
        columns: [{ title: 'First name', field: 'first_name', minWidth: 120, responsive: 0 },
          { title: 'Last name', field: 'last_name', minWidth: 120, responsive: 0 },
          { title: 'Username', field: 'username', minWidth: 140, responsive: 2, **export },
          { title: 'Recent homework', field: 'recent_homework', minWidth: 150, responsive: 3,
            headerSort: false, headerTooltip: 'The five homework due latest, earliest due first',
            clipboard: false, download: false },
          { title: 'Actions', field: 'actions', width: 64, responsive: 0, headerSort: false,
            cssClass: 'actions-column', clipboard: false, download: false }] }.to_json
    div[data-controller='datatable password-reset'
      data-datatable-options-value=students_table_options
      data-datatable-filename-value=csv_filename("#{@classroom.name} pupils")]
      .d-flex.flex-wrap.gap-2
        .flex-grow-1 = render 'shared/table_search', label: 'Search pupils'
        .d-flex.gap-2.mb-2
          button.btn.btn-outline-secondary type='button' data-action='click->datatable#copy' Copy
          button.btn.btn-outline-secondary type='button' data-action='click->datatable#downloadCsv' CSV
      table.table#students-table data-datatable-target='table'
        thead
          tr
            th First name
            th Last name
            th Username
            th Recent homework
            th Actions
        tbody
          - @students.each do |s|
            tr.student-data data-id=s.id
              / Visible as the first name, which its column heads; spoken as the full name
              td = link_to s.forename, user_path(s), aria: { label: "#{s.forename} #{s.surname}" }
              td = s.surname
              td = s.username
              td = homework_strip(@recent_homeworks, @recent_progress.fetch(s.id, {}))
              td = render('users/actions_menu', user: s)
      = render('users/password_reset_modal', id: 'password-reset')
