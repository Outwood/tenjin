- on_about = request.path == page_path('about')
nav#navbar-main.navbar.navbar-expand-sm.justify-content-between data-bs-theme="dark" class=(on_about ? 'bg-dark' : 'fixed-top')
  .container-fluid
    a.navbar-brand href=root_path
      i.fas.fa-vihara.fa-2x.text-white
      span#branding-text.navbar-text.text-uppercase.text-white.d-inline-block
        | Tenjin
    - unless devise_controller?
      button.btn.btn-light-outline.my-1 data-bs-toggle="modal" data-bs-target="#studentLoginModal"
        | Login
