nav#navbar-main.navbar.navbar-expand-md.bg-dark data-bs-theme="dark"
  .container-fluid
    a.navbar-brand href=system_root_path aria-current=('page' if current_page?(system_root_path))
      i.fas.fa-vihara.fa-2x.text-white
      span#branding-text.text-uppercase.text-white
        | Tenjin

    button.navbar-toggler(type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarSupportedContent"
      aria-controls="navbarSupportedContent"
      aria-expanded="false"
      aria-label="Toggle navigation")
      span.navbar-toggler-icon

    #navbarSupportedContent.collapse.navbar-collapse
      ul.navbar-nav.me-auto
        li.nav-item = nav_link 'Schools', system_schools_path, current: controller_path == 'system/schools'
        li.nav-item = nav_link 'Subjects', system_subjects_path, current: controller_path == 'system/subjects'
        li.nav-item = nav_link 'Users', system_users_path, current: controller_path == 'system/users'
        - if current_admin.super?
          li.nav-item = nav_link 'Customisations', system_customisations_path, current: controller_path == 'system/customisations'
        / #account-links carries these below the breakpoint, where the navbar collapses
        - if settings_menu_items.any?
          li.nav-item.dropdown.d-none.d-md-block#settings-menu
            button.nav-link.dropdown-toggle(type='button'
              data-bs-toggle='dropdown'
              aria-expanded='false') Settings
            ul.dropdown-menu
              - settings_menu_items.each do |label, path|
                li = link_to label, path, class: 'dropdown-item'
      / The collapsed menu lists the account items as links rather than hiding them behind the avatar
      ul#account-links.navbar-nav.border-top.border-secondary.mt-2.pt-2.d-md-none
        li.navbar-text.small.text-truncate = current_admin.email
        - settings_menu_items.each do |label, path|
          li.nav-item = nav_link label, path, current: current_page?(path)
        li.nav-item
          = button_to 'Sign out', destroy_admin_session_path,
            method: :delete,
            class: 'nav-link',
            form: { data: { turbo: false } }
      ul.navbar-nav.d-none.d-md-flex
        li.nav-item.dropdown#account-menu
          button.btn.rounded-circle.admin-avatar(type='button'
            class=admin_avatar_class(current_admin)
            data-bs-toggle='dropdown'
            aria-expanded='false'
            aria-label="Account menu for #{current_admin.email}")
            = current_admin.email.first.upcase
          ul.dropdown-menu.dropdown-menu-end
            li.dropdown-header.text-truncate title=current_admin.email = current_admin.email
            li
              = button_to 'Sign out', destroy_admin_session_path,
                method: :delete,
                class: 'dropdown-item',
                form: { data: { turbo: false } }
